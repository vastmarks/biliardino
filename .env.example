# --- used by `npm run dev` / `npm start` and by docker-compose.yml ---

# Admin password for /admin (min. 8 characters). Change this!
ADMIN_PASSWORD=change-me-please

# Random string that signs the admin login (min. 16 chars), e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app. Needed outside Docker (`npm start`); in Docker it's optional.
NEXTAUTH_URL=http://localhost:3000

# SQLite file. Relative paths are relative to the prisma/ folder (like the Prisma CLI).
# In Docker this is file:/data/hilde.db
DATABASE_URL=file:../data/hilde.db

# Time zone: decides when "Today" starts on the leaderboard
TZ=Europe/Rome

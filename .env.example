# Admin login for /admin (min. 8 chars). Change this!
ADMIN_PASSWORD=change-me-please

# Random string used to sign sessions (min. 16 chars), e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Public URL of the app
NEXTAUTH_URL=http://localhost:3000

# SQLite file. Relative paths are relative to the prisma/ folder (same as the Prisma CLI).
# In Docker this is set to file:/data/hilde.db
DATABASE_URL=file:../data/hilde.db

# Time zone of your office: decides what "Today" means on the leaderboard (Docker)
TZ=Europe/Rome

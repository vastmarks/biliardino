{
  "name": "biliardino",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && prettier --check src scripts",
    "test": "jest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "author": "vastmarks",
  "contributors": [
    "Kevin Hirczy <kevin@nehalist.io> (https://nehalist.io), author of the original Hilde"
  ],
  "license": "MIT",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.25.1",
    "@trpc/next": "^11.25.1",
    "@trpc/react-query": "^11.25.1",
    "@trpc/server": "^11.25.1",
    "better-sqlite3": "^12.11.1",
    "next": "^16.4.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=20.9"
  },
  "sideEffects": [
    "*.css"
  ],
  "description": "Self-hosted office foosball tracker (1v1/2v2, Elo, per-player stats). Based on Hilde by nehalist (MIT).",
  "overrides": {
    "eslint": "$eslint",
    "test-exclude": "^8.0.0"
  }
}

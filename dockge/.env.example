# Admin password for /admin (min. 8 characters). CHANGE THIS.
ADMIN_PASSWORD=change-me-please

# Random secret that signs the admin login (min. 16 characters).
# Generate one in a terminal with:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Port on your server (change it if another app already uses 3000)
HILDE_PORT=3000

# Your time zone
TZ=Europe/Rome

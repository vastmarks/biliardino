# Admin login for /admin (min. 8 chars). CHANGE THIS.
ADMIN_PASSWORD=change-me-please

# Random string that signs sessions (min. 16 chars). Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# The exact address people open in the browser (scheme + host + port, no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# Host port to publish (change if 3000 is taken on your server)
HILDE_PORT=3000

# Your office time zone
TZ=Europe/Rome
